# Normalise line endings: LF in the repository and in every checkout (WordPress coding standard).
* text=auto eol=lf

# Binary assets – never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mo   binary
*.zip  binary

# Keep development-only files out of `git archive` / release exports.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tests              export-ignore
/bin                export-ignore
/phpunit.xml.dist   export-ignore
/phpcs.xml.dist     export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/composer.lock      export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/tourivo_project_roadmap.md export-ignore

msgid "The Complete Agency Guide & Feature Showcase"
msgstr "পরিপূর্ণ এজেন্সি গাইড ও ফিচার পরিচিতি"

msgid "Tourivo Docs & Features Hub"
msgstr "ট্যুরিতো ডকুমেন্টেশন ও ফিচার হাব"

msgid "Tourivo"
msgstr "ট্যুরিতো"

msgid "Tourivo Dashboard"
msgstr "ট্যুরিতো ড্যাশবোর্ড"

msgid "Dashboard"
msgstr "ড্যাশবোর্ড"

msgid "The Next-Gen Travel, Tour & Accommodation Booking Engine for WordPress."
msgstr "ওয়ার্ডপ্রেসের জন্য আধুনিক ও স্বয়ংসম্পূর্ণ ভ্রমণ, ট্যুর ও হোটেল বুকিং ইঞ্জিন।"

msgid "Welcome back! Overview of your travel packages, hotel rooms, and live booking activity."
msgstr "স্বাগতম! আপনার ট্যুর প্যাকেজ, হোটেল রুম এবং সাম্প্রতিক বুকিং কার্যক্রমের সামগ্রিক বিবরণ।"

msgid "Tourivo is your all-in-one travel booking engine and tour management powerhouse for WordPress. Explore our complete feature catalog, step-by-step guides, and copyable shortcodes to launch your booking website effortlessly—no coding required!"
msgstr "ট্যুরিতো হল ওয়ার্ডপ্রেসের জন্য একটি অল-ইন-ওয়ান ট্রাভেল বুকিং ইঞ্জিন ও ট্যুর ম্যানেজমেন্ট পাওয়ারহাউস। কোনো কোডিং ছাড়াই সহজে আপনার বুকিং ওয়েবসাইট চালু করতে আমাদের সম্পূর্ণ ফিচার ক্যাটালগ, নির্দেশিকা ও শর্টকোডগুলো দেখুন!"

msgid "Go to Dashboard"
msgstr "ড্যাশবোর্ডে যান"

msgid "Configure Settings"
msgstr "সেটিংস কনফিগার করুন"

msgid "1. Introduction & Quick Start"
msgstr "১. পরিচিতি ও দ্রুত শুরু"

msgid "2. ✨ All Features Catalog"
msgstr "২. ✨ সকল ফিচারের তালিকা"

msgid "3. Creating Tour Packages"
msgstr "৩. ট্যুর প্যাকেজ তৈরি"

msgid "4. Hotels & Room Listings"
msgstr "৪. হোটেল ও রুম লিস্টিং"

msgid "5. Page Builders & Shortcodes"
msgstr "৫. পেজ বিল্ডার ও শর্টকোড"

msgid "6. Managing Orders & Bookings"
msgstr "৬. অর্ডার ও বুকিং পরিচালনা"

msgid "7. Tourivo Pro Features"
msgstr "৭. ট্যুরিতো প্রো ফিচারসমূহ"

msgid "What is Tourivo and How Does it Work?"
msgstr "ট্যুরিতো কী এবং এটি কীভাবে কাজ করে?"

msgid "Think of Tourivo as your private booking engine (similar to Booking.com, Airbnb, or Viator) operating directly inside your own WordPress website."
msgstr "ট্যুরিতোকে আপনার নিজস্ব প্রাইভেট বুকিং ইঞ্জিন (যেমন Booking.com, Airbnb, বা Viator) হিসেবে বিবেচনা করুন যা সরাসরি আপনার ওয়ার্ডপ্রেস ওয়েবসাইটের ভেতর কাজ করে।"

msgid "Tour Packages & Day Trips"
msgstr "ট্যুর প্যাকেজ ও ডে ট্রিপ"

msgid "Sell single-day adventures or multi-day guided trips with day-by-day itineraries, included meals, pickup locations, and passenger caps."
msgstr "একদিনের রোমাঞ্চকর ভ্রমণ বা একাধিক দিনের গাইডেড ট্যুর বিক্রি করুন বিস্তারিত আইটিনারারি, খাবার, পিকআপ লোকেশন ও যাত্রী সীমা সহ।"

msgid "Hotels, Resorts & Rooms"
msgstr "হোটেল, রিসোর্ট ও রুম"

msgid "List hotels, resorts, or guest houses. Attach multiple room units with specific bed styles, guest capacities, and per-night rates."
msgstr "হোটেল, রিসোর্ট বা গেস্ট হাউস যুক্ত করুন। নির্দিষ্ট বেড স্টাইল, অতিথি ধারণক্ষমতা ও রাতপ্রতি রেট সহ একাধিক রুম যুক্ত করুন।"

msgid "Anti-Double-Booking Protection"
msgstr "ডাবল-বুকিং প্রতিরোধ সুরক্ষা"

msgid "Our smart inventory engine automatically prevents two travelers from booking the same room or seat at the same time."
msgstr "আমাদের স্মার্ট ইনভেন্টরি ইঞ্জিন একই সময়ে একাধিক ভ্রমণকারী কর্তৃক একই রুম বা সিট বুকিং হওয়া স্বয়ংক্রিয়ভাবে প্রতিহত করে।"

msgid "🚀 4-Step Quick Launch Checklist"
msgstr "🚀 ৪-ধাপের দ্রুত চালুকরণ চেকলিস্ট"

msgid "Set Your Currency & Details"
msgstr "আপনার মুদ্রা ও তথ্য নির্ধারণ করুন"

msgid "Go to Tourivo -> Settings. Select your currency code (e.g. USD $, EUR €, BDT ৳), symbol position, and sender email."
msgstr "ট্যুরিতো -> সেটিংস-এ যান। আপনার মুদ্রার কোড (যেমন USD $, EUR €, BDT ৳), প্রতীকের অবস্থান এবং প্রেরক ইমেল নির্বাচন করুন।"

msgid "Open Settings"
msgstr "সেটিংস খুলুন"

msgid "Import Starter Demo Data (Recommended for Beginners)"
msgstr "স্টার্টার ডেমো ডাটা ইমপোর্ট করুন (নতুনদের জন্য সুপারিশকৃত)"

msgid "Instantly create complete starter packages: 3 guided tours (Bali, Swiss Alps, Dubai) and 2 boutique hotels with 4 rooms to see full itineraries, rooms, and booking forms in action."
msgstr "সম্পূর্ণ স্টার্টার প্যাকেজ তৈরি করুন: ৩টি আকর্ষণীয় ট্যুর (কক্সবাজার, সাজেক ভ্যালি, শ্রীমঙ্গল) এবং ২টি বুটিক হোটেল ও ৪টি রুম।"

msgid "⚡ Import Starter Demo Content Now"
msgstr "⚡ এখনই স্টার্টার ডেমো কন্টেন্ট ইমপোর্ট করুন"

msgid "Create or Edit Your Tours & Hotels"
msgstr "আপনার ট্যুর ও হোটেল তৈরি বা সম্পাদনা করুন"

msgid "Add your trip prices, itineraries, photos, room quantities, and pickup points using our beginner-friendly tabbed editor."
msgstr "আমাদের সহজ ট্যাব এডিটর ব্যবহার করে আপনার ট্রিপের মূল্য, ভ্রমণ পরিকল্পনা, ছবি, রুমের সংখ্যা এবং পিকআপ পয়েন্ট যুক্ত করুন।"

msgid "Publish on Pages via Shortcode or Elementor"
msgstr "শর্টকোড বা এলিমেন্টরের মাধ্যমে পেজে প্রকাশ করুন"

msgid "Paste shortcodes like [tourivo_tours] or [tourivo_filter_search] on any page or drag Tourivo widgets into Elementor."
msgstr "যেকোনো পেজে [tourivo_tours] বা [tourivo_filter_search]-এর মতো শর্টকোড বসান অথবা এলিমেন্টরে ট্যুরিতো উইজেট ড্র্যাগ করুন।"

msgid "View Shortcodes Table"
msgstr "শর্টকোড টেবিল দেখুন"

msgid "✨ Complete Tourivo Feature Catalog"
msgstr "✨ ট্যুরিতোর সম্পূর্ণ ফিচার ক্যাটালগ"

msgid "Complete Tourivo Feature Catalog"
msgstr "ট্যুরিতোর সম্পূর্ণ ফিচার ক্যাটালগ"

msgid "Explore the complete roster of features engineered into Tourivo to power modern travel agencies, tour operators, and boutique hoteliers."
msgstr "আধুনিক ট্রাভেল এজেন্সি, ট্যুর অপারেটর এবং বুটিক হোটেল পরিচালনার জন্য ট্যুরিতোতে তৈরি চমৎকার ফিচারগুলো দেখুন।"

msgid "Tour & Excursion Management"
msgstr "ট্যুর ও ভ্রমণ পরিচালনা"

msgid "FREE CORE"
msgstr "ফ্রি কোর"

msgid "PRO ADDON"
msgstr "প্রো অ্যাড-অন"

msgid "PRO"
msgstr "প্রো"

msgid "ENTERPRISE EXTENSIONS"
msgstr "এন্টারপ্রাইজ এক্সটেনশন"

msgid "Interactive Itinerary Builder"
msgstr "ইন্টারেক্টিভ আইটিনারারি বিল্ডার"

msgid "Create day-by-day or stage-by-stage itineraries with custom titles, included meals (Breakfast/Lunch/Dinner), and detailed descriptions."
msgstr "কাস্টম শিরোনাম, অন্তর্ভূক্ত খাবার (সকালের নাস্তা/দুপুরের খাবার/রাতের খাবার) এবং বিস্তারিত বিবরণ সহ দিনভিত্তিক ভ্রমণ পরিকল্পনা তৈরি করুন।"

msgid "Inclusions & Exclusions Checklist"
msgstr "অন্তর্ভুক্তি ও বহির্ভুক্তি চেকলিস্ট"

msgid "Visual checkmark and cross-mark list displaying what is included (e.g. Flight, Hotel, Tour Guide) and excluded (e.g. Visa, Tips)."
msgstr "কী কী অন্তর্ভুক্ত রয়েছে (যেমন ফ্লাইট, হোটেল, ট্যুর গাইড) এবং কী কী অন্তর্ভুক্ত নয় (যেমন ভিসা, টিপস) তা টিক ও ক্রস চিহ্নে প্রদর্শন করুন।"

msgid "GPS Map Coordinates & Pickup Points"
msgstr "জিপিএস ম্যাপ কোঅর্ডিনেট ও পিকআপ পয়েন্ট"

msgid "Define exact departure points, return drop-offs, and GPS Latitude/Longitude for interactive map pinpoints."
msgstr "ইন্টারেক্টিভ ম্যাপ পিনপয়েন্টের জন্য সঠিক যাত্রা শুরুর স্থান, ড্রপ-অফ স্থান এবং জিপিএস অক্ষাংশ/দ্রাঘিমাংশ নির্ধারণ করুন।"

msgid "Hotels, Resorts & Accommodation Engine"
msgstr "হোটেল, রিসোর্ট ও বাসস্থান ইঞ্জিন"

msgid "2-Level Hierarchy (Hotel -> Rooms)"
msgstr "২-স্তরের কাঠামো (হোটেল -> রুমসমূহ)"

msgid "Create parent hotels/resorts and attach unlimited individual room types (Deluxe Suite, Ocean Villa, Standard Room) with unique specs."
msgstr "প্রধান হোটেল/রিসোর্ট তৈরি করুন এবং এর অধীনে স্বতন্ত্র স্পেসিফিকেশন সহ একাধিক রুমের ধরন (ডিলাক্স সুইট, ওশান ভিলা, স্ট্যান্ডার্ড রুম) যুক্ত করুন।"

msgid "Star Ratings & Amenities"
msgstr "স্টার রেটিং ও সুযোগ-সুবিধাসমূহ"

msgid "Display 1 to 5 star rating badges, property check-in/out times, and assign custom amenities (Free WiFi, Pool, Spa)."
msgstr "১ থেকে ৫ স্টার রেটিং ব্যাজ, চেক-ইন/আউট সময় প্রদর্শন করুন এবং সুযোগ-সুবিধা (ফ্রি ওয়াইফাই, সুইমিং পুল, স্পা) যুক্ত করুন।"

msgid "Bed Styles & Dimensions"
msgstr "বেড স্টাইল ও সাইজ"

msgid "Specify room dimensions (m²/sqft) and bed configurations (King Bed, Twin Beds) for traveler clarity."
msgstr "ভ্রমণকারীদের স্পষ্ট ধারণার জন্য রুমের সাইজ (বর্গফুট/বর্গমিটার) এবং বেড কনফিগারেশন (কিং বেড, টুইন বেড) উল্লেখ করুন।"

msgid "Live Search, Filter & Traveler Wishlist"
msgstr "লাইভ সার্চ, ফিল্টার ও উইশলিস্ট"

msgid "Live AJAX Filter & Search [tourivo_filter_search]"
msgstr "লাইভ AJAX ফিল্টার ও সার্চ [tourivo_filter_search]"

msgid "Real-time, zero page-reload filtering by keyword, destination, budget range slider, duration, and star ratings."
msgstr "পেজ রিলোড ছাড়াই কিওয়ার্ড, গন্তব্য, বাজেট রেঞ্জ স্লাইডার, সময়কাল এবং স্টার রেটিং অনুযায়ী তাৎক্ষণিক ফিল্টারিং।"

msgid "Traveler Wishlist & Favorites [tourivo_wishlist]"
msgstr "ভ্রমণকারীদের উইশলিস্ট ও প্রিয় তালিকা [tourivo_wishlist]"

msgid "1-Click animated heart button on all cards. Snappy LocalStorage saving + cloud account sync for logged-in users."
msgstr "প্রতিটি কার্ডে ১-ক্লিক অ্যানিমেটেড হার্ট বাটন। লোকালস্টোরেজ সেভিং এবং লগইন করা ব্যবহারকারীদের ক্লাউড অ্যাকাউন্ট সিঙ্ক।"

msgid "Multi-Currency Switcher [tourivo_currency_switcher]"
msgstr "বহু-মুদ্রা সুইচার [tourivo_currency_switcher]"

msgid "Instant dropdown widget converting prices into USD, EUR, GBP, BDT ৳, INR ₹, AUD, CAD, and AED in real-time."
msgstr "তাৎক্ষণিক ড্রপডাউন উইজেট যা রিয়েল-টাইমে দামকে USD, EUR, GBP, BDT ৳, INR ₹, AUD, CAD, এবং AED-তে রূপান্তর করে।"

msgid "Trust, Reviews & Lead Management"
msgstr "আস্থা, রিভিউ ও কাস্টমার লিড পরিচালনা"

msgid "5-Star Reviews & Rating Scorecards"
msgstr "৫-স্টার রিভিউ ও রেটিং স্কোরকার্ড"

msgid "Interactive star rating submission form with aggregate 5★ to 1★ breakdown progress bars on single pages."
msgstr "একক পেজে বিস্তারিত ৫★ থেকে ১★ ব্রেকডাউন বার সহ ইন্টারেক্টিভ স্টার রেটিং ফর্ম।"

msgid "✓ Verified Traveler Trust Badge"
msgstr "✓ ভেরিফাইড ট্রাভেলার ট্রাস্ট ব্যাজ"

msgid "Automatically detects confirmed booking emails in database and awards a glowing Verified Traveler badge to genuine reviews."
msgstr "ডাটাবেসে কনফার্মড বুকিং স্বয়ংক্রিয়ভাবে শনাক্ত করে প্রকৃত রিভিউগুলোতে আকর্ষণীয় 'ভেরিফাইড ট্রাভেলার' ব্যাজ প্রদান করে।"

msgid "1-Click \"Trip Inquiry\" Lead Capture"
msgstr "১-ক্লিক \"ট্রিপ অনুসন্ধান\" লিড ক্যাপচার"

msgid "Lead capture popup directly on booking panels with instant admin email alerts and full lead management table in wp-admin."
msgstr "বুকিং প্যানেলে সরাসরি লিড ক্যাপচার পপআপ, তাৎক্ষণিক অ্যাডমিন ইমেল অ্যালার্ট এবং ডাব্লুপি-অ্যাডমিনে পূর্ণাঙ্গ লিড ম্যানেজমেন্ট।"

msgid "Booking Operations & Safety"
msgstr "বুকিং কার্যক্রম ও নিরাপত্তা"

msgid "Anti-Double-Booking Inventory Engine"
msgstr "অ্যান্টি-ডাবল-বুকিং ইনভেন্টরি ইঞ্জিন"

msgid "MySQL row-level pessimistic locking ensures zero double-booking or overselling even during high-traffic sales."
msgstr "MySQL রো-লেভেল পেসিমিস্টিক লকিং উচ্চ ট্রাফিকের সময়েও ডাবল বুকিং বা অতিরিক্ত বুকিং হওয়া প্রতিরোধ করে।"

msgid "Admin Manual Booking Creator"
msgstr "অ্যাডমিন ম্যানুয়াল বুকিং ক্রিয়েটর"

msgid "Log phone, WhatsApp, and walk-in offline bookings with inventory lock enforcement and reference code generation."

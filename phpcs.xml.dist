<?xml version="1.0"?>
<ruleset name="Tourivo Plugin Coding Standards">
    <description>PHP_CodeSniffer configuration for Tourivo plugin.</description>

    <!-- Scan only PHP files -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Paths to scan -->
    <file>app</file>
    <file>templates</file>
    <file>views</file>
    <file>tourivo.php</file>
    <file>uninstall.php</file>

    <!-- Excluded directories and patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/assets/fonts/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>

    <!-- PHPCompatibilityWP for PHP 8.0+ -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Minimum WordPress Version: 6.0 -->
    <config name="minimum_wp_version" value="6.0"/>

    <!--
        Rule scope.

        The codebase follows PSR-12 / PSR-4 (4-space indent, ClassName.php, camelCase), which the WordPress
        *formatting* sniffs (tabs, class-*.php file names, snake_case, file/class doc blocks, alignment) contradict.
        We therefore enforce the WordPress sniff groups that catch real bugs and review blockers - security,
        database, WP API usage, discouraged PHP, i18n and global prefixing - and leave pure style to PSR-12.
    -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.WP"/>
    <rule ref="WordPress.PHP">
        <!-- Pure style (Yoda conditions): enforced by review, not by the build. -->
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <!-- Warnings are advisory: only errors fail the build. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Custom capabilities registered by Tourivo on activation -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_tourivo"/>
                <element value="manage_tourivo_bookings"/>
                <element value="manage_tourivo_tours"/>
                <element value="manage_tourivo_hotels"/>
                <element value="manage_tourivo_settings"/>
                <element value="manage_tourivo_checkin"/>
            </property>
        </properties>
    </rule>

    <!-- Templates/views are included inside functions (tourivo_get_template, loadView), so their local
         variables are not globals and need no plugin prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/templates/*</exclude-pattern>
        <exclude-pattern>*/views/*</exclude-pattern>
    </rule>

    <!-- Text Domain Verification -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="tourivo"/>
            </property>
        </properties>
    </rule>

    <!-- Prefix Rule for Global Symbols -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="tourivo"/>
                <element value="Tourivo"/>
                <element value="TOURIVO"/>
            </property>
        </properties>
    </rule>
</ruleset>

<?xml version="1.0"?>
<ruleset name="Tourivo Plugin Coding Standards">
    <description>PHP_CodeSniffer configuration for Tourivo plugin.</description>

    <!-- Scan only PHP files -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Paths to scan -->
    <file>app</file>
    <file>templates</file>
    <file>views</file>
    <file>tourivo.php</file>
    <file>uninstall.php</file>

    <!-- Excluded directories and patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/assets/fonts/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>

    <!-- PHPCompatibilityWP for PHP 8.0+ -->
    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Minimum WordPress Version: 6.0 -->
    <config name="minimum_wp_version" value="6.0"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- Text Domain Verification -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="tourivo"/>
            </property>
        </properties>
    </rule>

    <!-- Prefix Rule for Global Symbols -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="tourivo"/>
                <element value="Tourivo"/>
                <element value="TOURIVO"/>
            </property>
        </properties>
    </rule>
</ruleset>

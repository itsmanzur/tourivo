includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - tourivo.php
        - uninstall.php
    # WP-CLI is only present when running under wp-cli; analyse against its stubs.
    scanDirectories:
        - vendor/php-stubs/wp-cli-stubs
    excludePaths:
        analyse:
            - tests/*
            - vendor/*
            - node_modules/*
            - dist/*
            - bin/*
    checkMissingIterableValueType: false
    ignoreErrors:
        # Elementor classes only exist when Elementor is active (the plugin guards for it at runtime).
        -
            message: '#Elementor.Elements_Manager#'
            path: app/Elementor/ElementorManager.php
        # Singleton trait: subclasses keep the (protected) constructor signature by convention.
        -
            message: '#^Unsafe usage of new static\(\)#'
            path: app/Common/Traits/Singleton.php
        # WordPress core accepts more register_block_type() keys (title, category, icon, ...) than the
        # php-stubs/wordpress-stubs array shape lists; the calls are valid.
        -
            message: '#^Parameter \#2 \$args of function register_block_type expects array#'
            path: app/Blocks/BlockManager.php
    checkGenericClassInNonGenericObjectType: false
    # Constants defined by the plugin bootstrap / WordPress at runtime.
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
